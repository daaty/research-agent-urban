# 🔑 CREDENCIAIS (OBRIGATÓRIAS)
RIDES_USERNAME=seu_usuario_rides
RIDES_PASSWORD=sua_senha_rides
N8N_WEBHOOK_URL=https://seu-n8n.com/webhook/webhook-id

# 🌐 URLs DO SISTEMA
