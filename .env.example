# ============================================
# VARIÁVEIS DE AMBIENTE - RESEARCH AGENT URBAN
# ============================================

# 🔑 CREDENCIAIS (OBRIGATÓRIAS)
RIDES_USERNAME=seu_usuario_rides
RIDES_PASSWORD=sua_senha_rides
N8N_WEBHOOK_URL=https://seu-n8n.com/webhook/webhook-id

# 🐌 CONTROLE DE VELOCIDADE DO HYBRID SCRAPER
# Multiplica os delays base para controlar velocidade de extração
# 1.0 = Velocidade normal
# 1.5 = 50% mais lento (RECOMENDADO para maior estabilidade)
# 2.0 = 100% mais lento (para conexões muito instáveis)
# 0.8 = 20% mais rápido (apenas para testes em ambiente estável)
HYBRID_SPEED_MULTIPLIER=1.5

# 🌐 URLs DO SISTEMA
RIDES_LOGIN_URL=https://rides.ec2dashboard.com/#/page/login

# 🏙️ CONFIGURAÇÃO DA CIDADE (Sistema Híbrido)
CITY_NAME=Matupá
CITY_API_URL=https://api-matupa.exemplo.com/drivers
CITY_API_TOKEN=token_cidade_aqui
CITY_ENABLED=true
FALLBACK_DRIVER_IDS=MAT001,MAT002,MAT003,MAT004,MAT005

# 🤖 CONFIGURAÇÕES DO NAVEGADOR
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=30000

# ⏰ CONFIGURAÇÕES DE SCRAPING
SCRAPE_INTERVAL=15
MAX_RETRIES=3
CACHE_ENABLED=true

# 🌐 CONFIGURAÇÕES DE REDE
PORT=3030

# 🐳 CONFIGURAÇÕES DOCKER
NODE_ENV=production
TZ=America/Sao_Paulo
