# ============================================
# VARIÁVEIS DE AMBIENTE - RESEARCH AGENT URBAN v3.0
# ============================================

# 🔑 CREDENCIAIS (OBRIGATÓRIAS)
RIDES_USERNAME=seu_usuario_rides
RIDES_PASSWORD=sua_senha_rides
N8N_WEBHOOK_URL=https://seu-n8n.com/webhook/webhook-id

# 🌐 URLs DO SISTEMA
RIDES_LOGIN_URL=https://rides.ec2dashboard.com/#/page/login

# 🤖 CONFIGURAÇÕES DO NAVEGADOR
BROWSER_HEADLESS=false
BROWSER_TIMEOUT=30000
HEADLESS_MODE=false

# ⏰ CONFIGURAÇÕES DE SCRAPING
SCRAPE_INTERVAL=15
MAX_RETRIES=3
CACHE_ENABLED=true

# 🌐 CONFIGURAÇÕES DE REDE
PORT=3000

# 🆕 DATABASE CONFIGURATION para Sistema de Prevenção de Duplicados (v3.0)
# Use as MESMAS credenciais que o n8n usa
DB_TYPE=postgresql
DB_HOST=n8n_postgres  
DB_PORT=5432
DB_USERNAME=n8n_user
DB_PASSWORD=n8n_pw
DB_NAME=n8n_db
DATABASE_URL=postgres://n8n_user:n8n_pw@n8n_postgres:5432/n8n_db

# 🐳 CONFIGURAÇÕES DOCKER
NODE_ENV=production
TZ=America/Sao_Paulo
