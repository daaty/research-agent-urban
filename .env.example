# ============================================
# VARIÁVEIS DE AMBIENTE - RESEARCH AGENT URBAN
# ============================================

# 🔑 CREDENCIAIS (OBRIGATÓRIAS)
RIDES_USERNAME=seu_usuario_rides
RIDES_PASSWORD=sua_senha_rides
N8N_WEBHOOK_URL=https://seu-n8n.com/webhook/webhook-id

# 🌐 URLs DO SISTEMA
RIDES_LOGIN_URL=https://carreira.ridesapp.com.br/driver/login

# 🤖 CONFIGURAÇÕES DO NAVEGADOR
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=30000

# ⏰ CONFIGURAÇÕES DE SCRAPING
SCRAPE_INTERVAL=15
MAX_RETRIES=3
CACHE_ENABLED=true

# 🌐 CONFIGURAÇÕES DE REDE
PORT=3030

# � CONFIGURAÇÃO DO DASHBOARD (IMPORTANTE!)
# true = Scraper master com dashboard (apenas UM deve ter)
# false/undefined = Scraper worker apenas scraping
ENABLE_DASHBOARD=true

# 🗄️ CONFIGURAÇÕES DO BANCO DE DADOS
DATABASE_URL=postgresql://user:password@localhost:5432/urban_scraper

# �🐳 CONFIGURAÇÕES DOCKER
NODE_ENV=production
TZ=America/Sao_Paulo

