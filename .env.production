# ========================================
# CONFIGURAÇÃO PARA PRODUÇÃO VPS
# ========================================

# 🔐 CREDENCIAIS (OBRIGATÓRIO)
RIDES_USERNAME=herbert@urbandobrasil.com.br
RIDES_PASSWORD=herbert@urban25
N8N_WEBHOOK_URL=https://n8n.urbanmt.com.br/webhook/rideswebscrap

# 🗄️ BANCO DE DADOS VPS
DATABASE_URL=postgres://n8n_user:n8n_pw@localhost:5432/n8n_db?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_NAME=n8n_db
DB_USER=n8n_user
DB_PASSWORD=n8n_pw
DB_SSL=false

# 🎛️ CONFIGURAÇÕES PRODUÇÃO
HEADLESS_MODE=false          # Browser visível para VNC
NODE_ENV=production          # Modo produção
SCRAPE_INTERVAL=5            # Intervalo otimizado (5 min)
ENABLE_DATABASE=true         # Habilitar salvamento no banco
ENABLE_WEBHOOK=true          # Habilitar webhook
ALLOW_NO_DATABASE=false      # Não permitir execução sem banco

# 🖥️ CONFIGURAÇÕES VNC PRODUÇÃO
VNC_PASSWORD=Urban2025VNC!
DISPLAY=:99

# 🚀 EXECUÇÃO AUTOMÁTICA
AUTO_START=false            # Não iniciar legacy automaticamente
AUTO_START_HYBRID=true      # Iniciar sistema híbrido automaticamente

# ⏰ SCRAPING OTIMIZADO
ENABLE_AUTO_SCRAPING=true
SCRAPE_INTERVAL=5
MAX_RETRIES=3
CACHE_ENABLED=true

# �️ CONFIGURAÇÕES VNC OTIMIZADAS
VNC_PASSWORD=suasenhaVNC123
DISPLAY=:99
VNC_RESOLUTION=1600x1200
VNC_DEPTH=24
VNC_DPI=96

# 🌐 NAVEGADOR OTIMIZADO PARA VNC
BROWSER_WIDTH=1600
BROWSER_HEIGHT=1200

# 🔧 CONFIGURAÇÕES DE PERFORMANCE VNC
VNC_SHARED=true
VNC_GEOMETRY=1600x1200
VNC_SCALE=1600x1200

# �🔄 SISTEMA HÍBRIDO PRODUÇÃO
HYBRID_EXTRACTION_BATCH_SIZE=1      # Processamento sequencial
HYBRID_STATE_CHECK_INTERVAL=8000    # 8 segundos entre verificações
HYBRID_MAX_RETRIES=3
HYBRID_TIMEOUT=30000

# 📊 LOGGING PRODUÇÃO
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_CONSOLE_LEVEL=INFO
