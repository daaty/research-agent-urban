 <style>
.dropdown-container {
    display: inline-block;
    cursor: pointer;
    position: relative;
}

.dropdown-men{
    position: absolute;
    background: white;
    border: 1px solid #ccc;
    border-radius: 4px;
    list-style: none;
    padding: 0;
    margin: 5px 0;
    width: 120px;
    box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
    z-index: 9999; /* Ensure it appears above navbar */
    top: 95%; /* Show below the button */
    left: 90%;
}

.dropdown-men li {
    padding: 8px 12px;
    cursor: pointer;
}

[ng-show="showDropdown"] {
    display: block !important;
}

.selectedLocale {
    background-color: #007bff; /* Blue background */
    color: white; /* White text */
    font-weight: bold;
}

.dropdown-men li:hover {
    background-color: #f0f0f0;
}

.dropdown-men li.selectedLocale:hover {
    background-color: #007bff ; /* Disable hover effect */
}
 </style>

