<div>
    <header class="header-styles">
        <h3 class="page-title heading">{{"DASHBOARD.VIEW_HEADING" | translate}}</h3>
    </header>


    <div class="row" style="margin-top: 50px">
        <!--code for upper div that accepts the value-->
        <div class="col-lg-12" ng-class="{'center-details': (!finalpermission.viewUserDetails || (!finalpermission.viewDashboardDriverDetails) || !finalpermission.viewRideDetails)}">
            <div ng-show="finalpermission.viewUserDetails" class="col-lg-4" ng-class="{'border-right': (finalpermission.viewDashboardDriverDetails || finalpermission.viewRideDetails)}">
                <modal title="Success" class="successModal" visible="success_flag">
                    <h4 style="text-align: center">{{alert_message | translate}}</h4>
                    <md-button type="button" class="close" style="margin-left: 45%;" data-dismiss="modal">{{"DASHBOARD.OK_BUTTON" | translate}}</md-button>
                </modal>



                <div class="outer-container">
                    <div text-center>
                        <div class="col-lg-12 sub-heading pl-pr-0">
                            <label for="userId">{{"DASHBOARD.USER_DETAILS" | translate}}</label>
                        </div>
                        <div class="col-xs-12" style="display: inline-flex;padding: 20px 20px 30px 20px;">
                            <input type="text" id="userId" class="form-control text-center" placeholder="{{'DASHBOARD.PLACEHOLDER_USER_DETAILS' | translate}}" ng-change="checkInputTypeUser(userID,'userId')"
                                ng-model="userID" ng-enter="getUserInfo()">
                        </div>
                        <div class="col-xs-12 d-flex justify-content-center" style="padding-left: 10px;padding-right: 10px">
                            <div class="form-group">
                                <md-radio-group layout="row" ng-model="enteredValue" class="md-primary radio-text ">
                                    <md-radio-button value="0" name="enteredValue" class="d-flex" style="margin-right: 35px;" ng-click="inputOption('userId',0)">{{"DASHBOARD.USER_ID" | translate}}</md-radio-button>
                                    <md-radio-button value="1" name="enteredValue" class="d-flex" style="margin-right: 35px;" ng-click="inputOption('userId',1)">
                                        {{"DASHBOARD.EMAIL" | translate}} </md-radio-button>
                                    <md-radio-button value="2" name="enteredValue" class="d-flex" ng-click="inputOption('userId',2)">{{"DASHBOARD.PHONE" | translate}} </md-radio-button>
                                </md-radio-group>
                            </div>
                            <script type="text/ng-template" id="blockUserID">
                                    <block-User></block-User>
                                </script>
                            <script type="text/ng-template" id="unsubscribeID">
                                 <unsubscribe-Id></unsubscribe-Id>
                                </script>
                        </div>
                    </div>
                </div>
                <div class="col-lg-12 button-user">
                    <md-button type="button" class="fancyButton" style="width: 50%" ng-click="getUserInfo()" ng-disabled="userDetailsBtn">
                        {{"DASHBOARD.USER_DETAILS" | translate}}
                    </md-button>
                </div>
            </div>

            <div ng-show="finalpermission.viewDashboardDriverDetails" class="col-lg-4 border-right">
                <div class="outer-container ">
                    <div class="col-lg-12 sub-heading pl-pr-0">
                        <label for="userId">{{displayBikeName}} {{"DASHBOARD.DETAILS2" | translate}}</label>
                    </div>
                    <div class="col-xs-12" style="display: inline-flex;padding: 20px 20px 30px 20px;">
                        <input type="text" id="driverId" class="form-control text-center" placeholder='{{showDeviceText ? "Enter ID/" + displayBikeName + " Number"  :"DASHBOARD.PLACEHOLDER_USER_DETAILS" | translate}}'
                            ng-change="checkInputType()" ng-model="driverID" ng-enter="getDriverInfo()">
                    </div>
                    <div class="col-xs-12 d-flex justify-content-center" style="padding-left: 10px;padding-right: 10px;">
                        <div class="form-group">
                            <md-radio-group  ng-model="enteredDriverValue" class="md-primary radio-text justify-content-center align-items-center">
                                <span class="col-xs-12 d-flex">
                                    <md-radio-button value="0" name="enteredDValue" class="d-flex" style="margin-right: 35px;" ng-click="inputOption('driverId',0)">{{"DASHBOARD.ID" | translate}}  {{displayBikeName}}</md-radio-button>
                                    <md-radio-button value="2" name="enteredDValue" class="d-flex" style="margin-right: 35px;" ng-click="inputOption('driverId',2)" ng-if="!showDeviceText">
                                        {{"DASHBOARD.PHONE" | translate}} </md-radio-button>
                                    <md-radio-button value="3" name="enteredDValue" class="d-flex" ng-click="inputOption('driverId',3)">{{showDeviceText ? displayBikeName + ' Number' :"DASHBOARD.VEHICLE_NUMBER" | translate}}</md-radio-button>
                                </span>
                                <span class="col-xs-12 d-flex">
                                    <md-radio-button ng-show="operator_id==3107" value="4" name="enteredDValue" ng-click="inputOption('driverId',4)" class="d-flex" >Captain ID</md-radio-button>
                                    <md-radio-button  value="5" name="enteredDValue" class="d-flex" style="margin-right: 35px;" ng-click="inputOption('driverId',5)" ng-if="showDeviceText">{{"DASHBOARD.STATION_ID" | translate}}</md-radio-button>
                                    <md-radio-button value="6" name="enteredDValue" class="d-flex" ng-click="inputOption('driverId',6)" ng-if="showDeviceText">{{"DASHBOARD.STATION_EXTERNAL_ID" | translate}}</md-radio-button>
                                </span>
                                <br>
                            </md-radio-group>
                        </div>
                    </div>
                </div>
                <div class="col-lg-12 driver-button">
                    <md-button type="submit" class="fancyButton" style="width: 52%" ng-click="getDriverInfo(enteredDriverValue)"> 
                         {{"DASHBOARD.DETAILS" | translate}} {{displayBikeName}}
                    </md-button>
                </div>
            </div>

            <div ng-show="finalpermission.viewRideDetails" class="col-lg-4">
                <div class="outer-container">
                    <div class="col-lg-12 sub-heading pl-pr-0">
                        <label for="userId">{{"DASHBOARD.RIDE_DETAILS" | translate}}</label>
                    </div>
                    <div class="col-xs-12" style="text-align: center;padding: 20px 20px 30px 20px;">
                        <!--<label for="engagementId">Engagement ID</label>-->
                        <input type="number" id="engagementId" class="form-control text-center" placeholder="{{'DASHBOARD.PLACEHOLDER_RIDE_DETAILS' | translate}}"
                            ng-model="engagementID1" ng-enter="viewRoute1(engagementID1)">
                    </div>
                    <div class="col-xs-12 d-flex justify-content-center" style="padding-left: 10px;padding-right: 10px;">
                        <div class="form-group">
                            <md-radio-group layout="row" ng-model="rideEngagementDetails" class="md-primary radio-text">
                                <md-radio-button value="0 " name="rideEngagementDetails">
                                    {{"DASHBOARD.RIDE_ID" | translate}}
                                </md-radio-button>
                            </md-radio-group>

                        </div>
                    </div>
                </div>
                <div class="col-lg-12 driver-button">
                    <md-button type="submit" class="fancyButton" style="flex:1;" ng-click="viewRoute1(engagementID1)" ng-disabled="engIdDetailsBtn">
                        {{"DASHBOARD.RIDE_DETAIL" | translate}}
                    </md-button>
                    <!-- <md-button type="button" class="fancyButton" style="flex:1" ng-click="editRide1(engagementID1)">Edit Ride
                                        </md-button> -->
                </div>
            </div>

            <script type="text/ng-template" id="rideRouteId">
                                <ride-Route-Id></ride-Route-Id>
                            </script>

            <script type="text/ng-template" id="mailSentSuccessfully">
                                <div class="row">
                                    <div class="row" style="color: var(--maincolor); text-align: center"><h3>{{"DASHBOARD.MAIL_SENT" | translate}}</h3></div>
                                    <div class="row" style="text-align: center; font-weight: bold; font-size: large; margin-top: 15px">{{"DASHBOARD.SUCCESS_MAIL_SENT" | translate}}</div>
                                </div>
                            </script>

            <!--modal for issue tracking-->
            <div id="issueTrackingModal" class="modal fade" role="dialog">
                <div class="modal-dialog" style="width: 60%;">

                    <!-- Modal content-->
                    <div class="modal-content">
                        <div class="modal-header" style="background-color: var(--secondaryColor); color:white; text-align: center">
                            <md-button type="button" ng-click="notDelivery()" class="close" data-dismiss="modal">&times;</md-button>
                            <h4 class="modal-title">Issue Tracking - {{selectedIssueCat}}</h4>
                        </div>
                        <form ng-submit="submitIssue(othersIssue);">
                            <div class="modal-body">
                                <div ng-show="showSubmitIssueResult">

                                    <p>
                                        <b>Please select the relevant issue :</b>
                                    </p>
                                    <div id="tree" style="margin-left: 20px;margin-top: 20px"></div>

                                    <div style="margin-left:20px ">

                                        <div ng-if="notGettingRidesTagID.val==50" style="margin-right: 10px">
                                            <div class="row" ng-show="showDriverDetails" style="margin:10px">

                                                <div ng-show="!noRideloading" class="row" style="background-color: #fff">
                                                    <div class="col-lg-12" style="border: 1px solid #B9B9BD;">
                                                        <div class="row" style="padding:3px;background-color: white"></div>
                                                        <div class="row">
                                                            <div class="col-lg-12 col-lg-offset-1">
                                                                <div class="col-lg-5">
                                                                    <label>Driver Details</label>
                                                                </div>
                                                                <div class="col-lg-1">
                                                                    <label>:</label>
                                                                </div>
                                                                <div class="col-lg-6">
                                                                    <label>{{driverSummary['Driver Name']+" ("+globaldriverID+")"}}</label>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="row" style="padding:3px;"></div>
                                                        <div class="row">
                                                            <div class="col-lg-12 col-lg-offset-1">
                                                                <div class="col-lg-5">
                                                                    <label>Driver Suspended</label>
                                                                </div>
                                                                <div class="col-lg-1">
                                                                    <label>:</label>
                                                                </div>
                                                                <div class="col-lg-6">
                                                                    <label ng-if="noRideStatusData.details[0].driver_suspended==1">Yes</label>
                                                                    <label ng-if="noRideStatusData.details[0].driver_suspended==0">No</label>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="row" style="padding:3px;background-color: white"></div>
                                                        <div class="row">
                                                            <div class="col-lg-12 col-lg-offset-1">
                                                                <div class="col-lg-5">
                                                                    <label>Last Ride Request On</label>
                                                                </div>
                                                                <div class="col-lg-1">
                                                                    <label>:</label>
                                                                </div>
                                                                <div class="col-lg-6">
                                                                    <label> {{noRideStatusData.lastReq[0].last_ride_req_on | date:
                                                                        'dd/MM/yyyy hh:mm a'}}</label>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="row" style="padding:3px;background-color: white"></div>
                                                        <div class="row">
                                                            <div class="col-lg-12 col-lg-offset-1">
                                                                <div class="col-lg-5">
                                                                    <label>Last Ride Done On</label>
                                                                </div>
                                                                <div class="col-lg-1">
                                                                    <label>:</label>
                                                                </div>
                                                                <div class="col-lg-6">
                                                                    <label> {{noRideStatusData.lastRideOn[0].last_ride_on | date:
                                                                        'dd/MM/yyyy hh:mm a '}}</label>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="row" style="padding:3px;background-color: white"></div>
                                                        <div class="row">
                                                            <div class="col-lg-12 col-lg-offset-1">
                                                                <div class="col-lg-5">
                                                                    <label>last connection</label>
                                                                </div>
                                                                <div class="col-lg-1">
                                                                    <label>:</label>
                                                                </div>
                                                                <div class="col-lg-6">
                                                                    <label> {{noRideStatusData.details[0].timestamp | date: 'dd/MM/yyyy
                                                                        hh:mm a'}}</label>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="row" style="padding:3px;background-color: white"></div>
                                                    </div>
                                                </div>
                                                <div ng-show="!noRideloading" class="row" style="margin-top: 10px">
                                                    <div class="table-responsive">
                                                        <table class="table table-striped">
                                                            <thead class="thead-style">
                                                                <tr>
                                                                    <th>Hour</th>
                                                                    <th>Minutes connected to net</th>
                                                                    <th>Requests Sent</th>
                                                                    <th>Requests Received</th>
                                                                    <th>Requests Accepted</th>
                                                                    <th>Rides Completed</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <tr ng-repeat="data in noRideStatusData.hourlyRides">
                                                                    <td>
                                                                        <span ng-if="$index==0" style="display:block">{{"last "+($index+1)+" hour"}}</span>
                                                                        <span ng-if="$index!=0" style="display:block">{{"last "+($index)+"-"+($index+1)+" hour"}}</span>
                                                                    </td>
                                                                    <td>{{noRideStatusData.hourlyMinutes[$index].onlineMinutes}}</td>
                                                                    <td>{{data.rides_sent}}</td>
                                                                    <td>{{data.requests_received}}</td>
                                                                    <td>{{data.rides_accepted}}</td>
                                                                    <td>{{data.rides_completed}}</td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div>
                                            <textarea rows="5" cols="60" ng-model="othersIssue" class="form-control" placeholder="Please describe your issue here" style="resize:none;"></textarea>
                                        </div>
                                    </div>

                                    <p>
                                        <b>Status</b>
                                    </p>

                                    <div style="margin-left:30px ">
                                        <div class="form-group">
                                            <label style="margin-left: 10px">
                                                <input type="radio" value="2" name="issueTicketStatus" ng-model="issueTicketStatus" required>
                                                <span style="margin-left: 5px">Open</span>
                                            </label>
                                            <label style="margin-left: 10px">
                                                <input type="radio" value="5" name="issueTicketStatus" ng-model="issueTicketStatus">
                                                <span style="margin-left: 5px">Close</span>
                                            </label>

                                        </div>
                                    </div>

                                    <p>
                                        <b>Priority</b>
                                    </p>

                                    <div style="margin-left:30px ">
                                        <div class="form-group">
                                            <label style="margin-left: 10px">
                                                <input type="radio" value="1" name="issueTicketPriority" ng-model="issueTicketPriority" required>
                                                <span style="margin-left: 5px">Low</span>
                                            </label>
                                            <label style="margin-left: 10px">
                                                <input type="radio" value="2" name="issueTicketPriority" ng-model="issueTicketPriority">
                                                <span style="margin-left: 5px">Medium</span>
                                            </label>
                                            <label style="margin-left: 10px">
                                                <input type="radio" value="3" name="issueTicketPriority" ng-model="issueTicketPriority">
                                                <span style="margin-left: 5px">High</span>
                                            </label>
                                            <label style="margin-left: 10px">
                                                <input type="radio" value="4" name="issueTicketPriority" ng-model="issueTicketPriority">
                                                <span style="margin-left: 5px">Urgent</span>
                                            </label>
                                        </div>
                                    </div>

                                    <p>
                                        <b>Q/R/C</b>
                                    </p>

                                    <div style="margin-left:30px ">
                                        <div class="form-group">
                                            <label style="margin-left: 10px">
                                                <input type="radio" value="1" name="issueTicketQRC" ng-model="issueTicketQRC" required>
                                                <span style="margin-left: 5px">Query</span>
                                            </label>
                                            <label style="margin-left: 10px">
                                                <input type="radio" value="2" name="issueTicketQRC" ng-model="issueTicketQRC">
                                                <span style="margin-left: 5px">Request</span>
                                            </label>
                                            <label style="margin-left: 10px">
                                                <input type="radio" value="3" name="issueTicketQRC" ng-model="issueTicketQRC">
                                                <span style="margin-left: 5px">Complaint</span>
                                            </label>
                                        </div>
                                    </div>

                                    <p>
                                        <b>Calling Type</b>
                                    </p>

                                    <div style="margin-left:30px ">
                                        <div class="form-group">
                                            <label ng-repeat="option in erpCallingTypes" style="margin-left: 10px">
                                                <input type="radio" value="{{option.id}}" name="issueTicketERP" ng-model="$parent.issueTicketERP" ng-change="cacheErpType.setVal($parent.issueTicketERP)">
                                                <span style="margin-left: 5px">{{option.name}}</span>
                                            </label>
                                        </div>
                                    </div>

                                    <p>
                                        <b>Add Image</b>
                                    </p>

                                    <div style="margin-left:30px ">
                                        <div class="form-group">
                                            <label style="margin-left: 10px">
                                                <span style="margin-left: 5px">Image 1</span>
                                                <input type="file" id="uploadCaptureInputFile1" accept="image/*" file-model="myFile1" class="form-control file1" />
                                            </label>
                                            <label style="margin-left: 10px">
                                                <span style="margin-left: 5px">Image 2</span>
                                                <input type="file" id="uploadCaptureInputFile2" accept="image/*" file-model="myFile2" class="form-control file1" />
                                            </label>
                                            <label style="margin-left: 10px">
                                                <span style="margin-left: 5px">Image 3</span>
                                                <input type="file" id="uploadCaptureInputFile3" accept="image/*" file-model="myFile3" class="form-control file1" />
                                            </label>
                                            <label style="margin-left: 10px">
                                                <span style="margin-left: 5px">Image 4</span>
                                                <input type="file" id="uploadCaptureInputFile4" accept="image/*" file-model="myFile4" class="form-control file1" />
                                            </label>
                                        </div>
                                    </div>
                                </div>

                                <div ng-hide="showSubmitIssueResult" style="text-align: center; color: #FF8162">
                                    <h3> Thank You !</h3>
                                    <b> Issue has been successfully submitted. </b>
                                </div>
                            </div>

                            <div class="modal-footer">
                                <div style="text-align: left; color: red">
                                    {{IssueErrorMsg | translate}}
                                </div>
                                <md-button type="submit" class="fancyButton" ng-show="showSubmitIssueResult" ng-disabled="disableIssueTrackingSubmitButton">
                                    Submit
                                    <span class="glyphicon glyphicon-refresh glyphicon-refresh-animate" ng-show="disableIssueTrackingSubmitButton"></span>
                                </md-button>
                                <md-button type="button" ng-click="notDelivery()" class="fancyButton" data-dismiss="modal">{{showSubmitIssueResult==false?'OK':'Cancel'}}</md-button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!--modal for Start End Cheating-->
            <div id="startEndModal" class="modal fade" role="dialog">
                <div class="modal-dialog" style="width: 60%;">

                    <!-- Modal content-->
                    <div class="modal-content">
                        <div class="modal-header" style="background-color: var(--secondaryColor); color:white; text-align: center">
                            <md-button type="button" class="close" data-dismiss="modal">&times;</md-button>
                            <h4 class="modal-title">Issue Tracking - Start End Cheating Case</h4>
                        </div>
                        <form>
                            <div class="modal-body">
                                <div ng-show="showStartEndAutomationResponseSteps">

                                    <p>
                                        <b>Action To Be Taken</b>
                                    </p>

                                    <div>
                                        <ol>
                                            <li ng-repeat="data in automationResponseData.process.actions">{{data}}</li>
                                        </ol>

                                    </div>


                                    <p>
                                        <b>Do you have a ticket ID?</b>
                                    </p>

                                    <div style="margin-left:20px ">
                                        <div class="form-group">
                                            <label style="margin-left: 10px">
                                                <input type="radio" value="0" name="issueTicketID" ng-model="issueTicketID" required>
                                                <span style="margin-left: 5px">Yes</span>
                                            </label>
                                            <label style="margin-left: 10px">
                                                <input type="radio" value="1" name="issueTicketID" ng-model="issueTicketID">
                                                <span style="margin-left: 5px">No</span>
                                            </label>
                                        </div>
                                    </div>

                                    <div ng-if="issueTicketID==0" style="margin-left:30px ">
                                        <div class="form-group">
                                            <input type="number" style="margin-left: 10px;width: 50%;" class="form-control" placeholder="Enter Ticket ID" ng-model="ticketIDText.val"
                                            />
                                        </div>
                                    </div>
                                </div>

                                <div ng-if="errorCaught">
                                    <div class="text-center row">
                                        <label>{{ErrorMessage}}</label>
                                    </div>
                                </div>


                                <div ng-hide="showSubmitIssueResult" style="text-align: center; color: #FF8162">

                                    <h3>{{status_of_case}}</h3>
                                    <b>{{alert_message| translate}}</b>
                                </div>


                            </div>
                            <div class="modal-footer">
                                <div style="text-align: left; color: red">
                                    {{IssueErrorMsg | translate}}
                                </div>
                                <md-button type="submit" class="fancyButton" ng-click="submitStartEndCheating()" ng-show="showSubmitIssueResult" ng-disabled="takingAction || (issueTicketID==0 &&
                                                        (ticketIDText.val=='' || ticketIDText.val==undefined))"> Submit
                                    <span style="margin-left: 5px" class="glyphicon glyphicon-refresh glyphicon-refresh-animate" id="loading" ng-if="takingAction"></span>
