        z-index:100000 !important; /* any number of choice > 1050*/
    }
    .wl-date .md-datepicker-input{
        background-color: white;
        min-width: 212px!important;
        min-height: 40px;
        border-radius: 10px;
        padding-left:15px;
    }

    .wl-date .md-datepicker-input-container{
        border: none !important;
    }
    
    .wl-date .md-datepicker-triangle-button.md-button.md-icon-button{
       margin-right: 20px;
       margin-bottom: 5px;
    }
