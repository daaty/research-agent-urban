<div ng-show="finalpermission.viewDeactiveDrivers">

    <header class="header-styles">
        <h2 class="page-title heading">{{showDeviceText ? "DEACTIVATED_DRIVERS.DEACTIVATED_AGENTS" : "DEACTIVATED_DRIVERS.HEADING_VIEW" | translate}}</h2>
    </header>
    <div class="row panel-box-custom text-center margin-top-30" ng-if="table" ng-show="!checkbox.bothDriver&&!checkbox.jugnooDriver">
        <div class="col-lg-12" ng-hide="aclcontroll">
            <!--table_options_container-->
            <!--table_options_buttons-->
            <div class="col-md-offset-1 col-md-8 text-center">


                <div class="form-group">
                    <div class="col-lg-4"></div>
                    <div class="col-lg-2"></div>
                    <div class="col-lg-3" ng-hide="dodoSuspendedDriver">
                        <input type="checkbox" ng-model="checkbox.jugnoo_unsuspend" ng-disabled="dodo_unsuspendCheckbox" />
                        <label style="margin-left: 5px;">{{"DEACTIVATED_DRIVERS.HEADING_VIEW_JUGNOO" | translate}}</label>
                    </div>
                    <div class="col-lg-3" ng-hide="jugnooSuspendedDriver">
                        <input type="checkbox" ng-model="checkbox.dodo_unsuspend" ng-disabled="jugnoo_unsuspendCheckbox" />
                        <label style="margin-left: 5px;">{{"DEACTIVATED_DRIVERS.HEADING_VIEW_DODO" | translate}}</label>
                    </div>
                    <div class="col-lg-2"></div>
                </div>
                <br>
                <br>
                <div class="col-md-7 ">
                    <!--table_options_container-->
                    <div class="form-group" style="float: right;">
                        <label style="width: 160px;">{{"DEACTIVATED_DRIVERS.HEADING_REASON_ACTIVATION" | translate}}</label>
                        <select style="width:80%;margin: 12px auto 0px;" class="form-control" ng-model="unsuspendedreason.res" style="width: 50%;margin-left: 25%;">
                            <option value="0">{{"DEACTIVATED_DRIVERS.SELECT_REASON" | translate}}</option>
                            <option ng-repeat="items in ddnUnSuspendList" value="{{items.id}}">{{items.reason_text}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-4">

                    <div class="form-group">
                        <label style="float: right;">{{"DEACTIVATED_DRIVERS.HEADING_COUNT" | translate}}: {{unsuspendedreason_other.length ? unsuspendedreason_other.length
                            : 0}}</label>
                        <textarea rows="3" type="text" class="form-control ng-pristine ng-valid ng-touched" ng-model="unsuspendedreason_other" placeholder='{{"DEACTIVATED_DRIVERS.PLACEHOLDER_COMMENTS" | translate}}'></textarea>
                    </div>
                </div>
                <div class="col-md-offset-3">

                    <button class="btn btn-dark-custom " ng-click="UnblockOnServer(unsuspendedreason,unsuspendedreason_other,checkbox.jugnoo_unsuspend,checkbox.dodo_unsuspend)"
                        style="margin-left: 63%;">{{"DEACTIVATED_DRIVERS.BUTTON_ACTIVATION" | translate}}</button>

                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xs-12">
            <!-- <button type="button" class="btn fancyButton pull-right" send-btn city-selected = "{{city}}" driver-selected="{{driversToSendSms}}" style="margin: 0 15px; height: 36px">
                    <i class="fa fa-envelope" aria-hidden="true" style="float:left;padding-right:10px;padding-top: 4px"></i>Send SMS
                </button>-->
            <!--<md-button style="margin:0" class="fancyButton pull-right" ng-click="bulkSuspendedDriver()" >Bulk Deactivation</md-button>-->
        </div>
    </div>


    <div class="panel-box-custom" ng-if="!showDeviceText">
        <ul class="fancy-tabs nav nav-tabs" style="padding-top: 5px" >
            <li class=" text-center" data-toggle="tab" ng-if="vehicleArray.length" style="padding:0px 0px 0px 0px;" ng-repeat="vehicle in activeDriverTabData"
                ng-class="{'active':vehicle.selection==true}" ng-click="showSuspendedDriverVehicleRelativeData(vehicle.link);">
                <a showTabdata-toggle="tab" class="deactivated-tab">{{vehicle.name}}</a>
            </li>
        </ul>
        <ul ng-show="operator == 1" class=" fancy-tabs nav nav-tabs" style="padding-top: 10px">
            <li class=" text-center" data-toggle="tab" style="padding:0px 0px 0px 0px;" ng-repeat="tabs in SuspendedDriverTabs"
                ng-class="{'active':tabs.selection==true}" ng-click="showSuspendedDriverTabRelativeData(tabs.link);">
                <a showTabdata-toggle="tab" class="deactivated-tab">{{tabs.name}}</a>
            </li>
        </ul>
    </div>
    <div style="display: none" class="form-group" ng-show="operator ==1">
        <div class="col-lg-3" ng-show="jugnooSuspendedDriver&&!dodoSuspendedDriver">
            <md-checkbox aria-label="" style="margin-bottom: 0" ng-model="checkbox.bothDriver" ng-click="checkBoxDataAutos(checkbox.bothDriver,checkbox.jugnooDriver, vehicleTab)">
                {{"DEACTIVATED_DRIVERS.INCLUDE_DODO" | translate}}
            </md-checkbox>
        </div>
        <div class="col-lg-3" ng-show="!jugnooSuspendedDriver&&dodoSuspendedDriver">
            <md-checkbox aria-label="" style="margin-bottom: 0" ng-model="checkbox.jugnooDriver" ng-click="checkBoxDataDodos(checkbox.bothDriver,checkbox.jugnooDriver, vehicleTab)">
                {{"DEACTIVATED_DRIVERS.INCLUDE_AUTO" | translate}}
            </md-checkbox>
        </div>
    </div>
    <md-button class="fancyButton " style="margin-left:30px" ng-click="exportCsv()" ng-show="exportOptionsEnabled">{{"DEACTIVATED_DRIVERS.EXPORT_CSV" | translate}}</md-button>


    <!-- START DATATABLE 2 -->

    <div class="panel-table-custom pt-5">
        <div class="col-md-6" style="margin: 20px;">
            <div style="display: flex; justify-content: space-between;align-items: center;">    
                <input class="form-control" type="text" ng-model="searchTerm" style="width: 70% !important;
                height: 40px; border-color: #00000078;" placeholder="Enter driver id or phone number to filter data" ng-change="searchBlankData()">
                <button class="md-button fancyButton" ng-click="searchData(searchTerm)">Search</button>
                <button class="md-button fancyButton" ng-disabled="!searchTerm" ng-click="clearSearchFilter()">Clear</button>
            </div>
        </div>

        <table id="deactivatedDriver" class="table t-fancy-table nowrap">
            <thead>
                <tr>
                    <th>{{"DEACTIVATED_DRIVERS.TABLE_HEADING_SELECT" | translate}}</th>
                    <th>{{showDeviceText ? "DEACTIVATED_DRIVERS.SERVICE_AGENT_ID" : "DEACTIVATED_DRIVERS.TABLE_HEADING_DRIVERID" | translate}}  </th>
                    <th>{{showDeviceText ? "DEACTIVATED_DRIVERS.SERVICE_AGENT_NAME" : "DEACTIVATED_DRIVERS.TABLE_HEADING_DRIVERNAME" | translate}}</th>
                    <th>{{showDeviceText ? "DEACTIVATED_DRIVERS.UNIQUE_IMEI" : "DEACTIVATED_DRIVERS.TABLE_HEADING_MOBILE" | translate}}</th>
                    <th ng-if="!multipleVehicleEnabled"><span ng-if="showDeviceText">{{displayBikeName}} </span>{{showDeviceText ? "DEACTIVATED_DRIVERS.BIKE_NUMBER" : "DEACTIVATED_DRIVERS.TABLE_HEADING_VEHICLENO" | translate}}</th>
                    <th>{{"DEACTIVATED_DRIVERS.TABLE_HEADING_REGON" | translate}}</th>
                    <th>{{"DEACTIVATED_DRIVERS.TABLE_HEADING_DEACTIVATIONON" | translate}}</th>
                    <th>{{"DEACTIVATED_DRIVERS.TABLE_HEADING_LASTLOG" | translate}}</th>
                    <th>{{"DEACTIVATED_DRIVERS.TABLE_HEADING_TOTALRIDE" | translate}} {{showDeviceText ? "DEACTIVATED_DRIVERS.TASKS" : "DEACTIVATED_DRIVERS.RIDES" | translate}}</th>
                    <th>{{"DEACTIVATED_DRIVERS.TABLE_HEADING_LAST" | translate}} {{showDeviceText ? "DEACTIVATED_DRIVERS.TASK" : "DEACTIVATED_DRIVERS.RIDE" | translate}} {{"DEACTIVATED_DRIVERS.ON" | translate}}</th>
                    <th>{{"DEACTIVATED_DRIVERS.TABLE_HEADING_REASON" | translate}}</th>

                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="data in displayData" ng-click="ClickDriverDataUrl(data)">
                    <td ng-click="$event.stopPropagation();">
                        <input type="checkbox" aria-label="" style="margin-bottom: 0" id="{{data.driver_id}}" ng-model="data.Selected" ng-click="checkboxvalue(data)"/>
                    </td>
                    <td>{{data.driver_id}}</td>
                    <td>{{data.driver_name}}</td>
                    <td>{{data.phone_no}}</td>
                    <td ng-if="!multipleVehicleEnabled">{{data.vehicle_number? data.vehicle_number:'--'}}</td>
                    <td>{{data.date_reg ? (data.date_reg | date:'dd-MM-yyyy') : "--"}}</td>
                    <td>{{data.last_suspended_on ? (data.last_suspended_on | date:'dd-MM-yyyy') : "--"}}</td>
                    <td>{{data.last_login ? (data.last_login | date:'dd-MM-yyyy') :"--"}}</td>
                    <td>{{data.total_rides? data.total_rides : 0}}</td>
                    <td>{{data.last_ride_on ? (data.last_ride_on | date:'dd-MM-yyyy') :"--"}}</td>
                    <td>{{data.last_suspended_reason}}</td>
                </tr>
            </tbody>
        </table>
        <div class="footer-section" style="float: right;">
            <ul uib-pagination total-items="pagination.totalItems" max-size="5" items-per-page="pagination.perPage"
                ng-model="pagination.currentPage" class="pagination-md" ng-change="getData()"
                boundary-link-numbers="true" rotate="true" boundary-links="true" previous-text="{{ 'PAGINATION.PREVIOUS' | translate }}" next-text="{{ 'PAGINATION.NEXT' | translate }}" first-text="{{ 'PAGINATION.FIRST' | translate }}" last-text="{{ 'PAGINATION.LAST' | translate }}"></ul>
        </div>
    </div>


    <modal title="Unblock driver" class="dashboardDialogModal" visible="showUnblockFlag">
        <div class="form-group text-center">
            <!--table_options_container-->
            <div class="form-group">
                <label style="width: 160px;">{{"DEACTIVATED_DRIVERS.HEADING_REASON_ACTIVATION" | translate}} </label>
                <select class="form-control" ng-model="unsuspendedreason.res" ng-change="otherReason(unsuspendedreason.res)" style="width: 50%;margin-left: 25%;">
                    <!--style="margin-top: 8px;width:150px;"-->
                    <option value="0">{{"DEACTIVATED_DRIVERS.SELECT_REASON" | translate}}</option>
                    <option value="1">{{"DEACTIVATED_DRIVERS.HEADING_WARNING" | translate}}</option>
                    <option value="2">{{"DEACTIVATED_DRIVERS.HEADING_FINE" | translate}}</option>
                    <option value="3">{{"DEACTIVATED_DRIVERS.HEADING_OTHER" | translate}}</option>
                </select>
            </div>
            <div style="margin-right: -35%;">{{"DEACTIVATED_DRIVERS.HEADING_COUNT" | translate}}: {{unsuspendedreason_other.length ? unsuspendedreason_other.length
                : 0}}</div>
            <div class="form-group" style="width: 50%;margin-left: 25%;">
                <textarea style="margin: 12px auto 0px" rows="5" type="text" class="form-control" ng-model="unsuspendedreason_other" placeholder='{{"DEACTIVATED_DRIVERS.PLACEHOLDER_COMMENTS" | translate}}'></textarea>
            </div>
            <div class="form-group">
                <button class="btn btn-dark-custom " id="mark_recovered" ng-click="UnblockOnServer(unsuspendedreason.res,unsuspendedreason_other)">{{"DEACTIVATED_DRIVERS.BUTTON_ACTIVATION" | translate}}</button>
                <button class="btn btn-dark-custom" data-dismiss="modal" aria-hidden="true">{{"DEACTIVATED_DRIVERS.BUTTON_CANCEL" | translate}}</button>
            </div>
        </div>
    </modal>

    <div id="myModal" class="modal fade" role="dialog">
        <div class="modal-dialog" style="width:25%;top:115px">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header text-center" style="color:white;background:green">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">{{"DEACTIVATED_DRIVERS.SUCCESS" | translate}}</h4>
                </div>
                <div class="modal-body text-center">
                    <h4>{{"DEACTIVATED_DRIVERS.DRIVER_ACTIVATED" | translate}}</h4>
                    <button type="button" class="btn btn-primary-custom" data-dismiss="modal" ng-click="BackDriverTable()">{{"DEACTIVATED_DRIVERS.BUTTON_OK" | translate}}</button>
                </div>
            </div>
        </div>
    </div>

    <div id="WarnModal" class="modal fade" role="dialog">
        <div class="modal-dialog" style="width:25%;top:115px">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header text-center" style="color:white;background:green">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">Success</h4>
                </div>
                <div class="modal-body text-center">
                    <h4>{{msg_on_success| translate}}</h4>
                    <button type="button" class="btn btn-primary-custom" data-dismiss="modal" ng-click="refresh()">{{"DEACTIVATED_DRIVERS.BUTTON_OK" | translate}}</button>
                </div>
            </div>
        </div>
    </div>

    <modal title="Error" class="errorModal" visible="auto_error_flag">
        <div class=" text-center">
            <h4 style="text-align: center">{{alert_message| translate}}</h4>
        </div>
    </modal>

    <modal title="Warning" class="warningModal" visible="warning_flagpopup">
        <h4 style="text-align: center;">{{alert_message| translate}}</h4>
        <button type="button" class="btn btn-primary" style="margin-left: 45%;" data-dismiss="modal">{{"DEACTIVATED_DRIVERS.BUTTON_OK" | translate}}</button>

    </modal>

    <modal title="Success" class="successModal" visible="warning_flag2">
        <h4 style="text-align: center">{{alert_message| translate}}</h4>
        <div class="modal_buttons">
            <button class="btn btn-primary-custom" ng-click="confirm_box()">{{"DEACTIVATED_DRIVERS.BUTTON_OK" | translate}}</button>
        </div>

    </modal>

    <div id="bulkSuspensionModal" class="modal fade" role="dialog">
        <div class="modal-dialog" style="width:60%;">
            <div class="modal-content">
                <div class="modal-header text-center" style="background:var(--mainColor);color:white">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">{{"DEACTIVATED_DRIVERS.HEADING_DEACTIVATION" | translate}}</h4>
                </div>

                <div class="modal-body text-center" style="margin-top: 1%;">
                    <div ng-if="operator == 1" class="row">
                        <div class="col-lg-1"></div>
                        <div class="col-lg-3">
                            <label style="float: right">{{"DEACTIVATED_DRIVERS.HEADING_DEACTIVATION_FORM" | translate}} </label>
                        </div>
                        <div class="col-lg-1">:</div>

                        <div class="col-lg-3">
                            <input type="checkbox" ng-model="jugnoo_suspend_bulk" style="float: left;">
                            <label style="margin-left: 5px;float: left;">{{"DEACTIVATED_DRIVERS.HEADING_VIEW_JUGNOO" | translate}}</label>

                        </div>
                        <div class="col-lg-3" style="margin-left: -4%;">
                            <input type="checkbox" ng-model="dodo_suspend_bulk" style="float: left;">
                            <label style="margin-left: 5px;float: left;">{{"DEACTIVATED_DRIVERS.HEADING_VIEW_DODO" | translate}}</label>
                        </div>
                    </div>
                    <br>
                    <div class="row">
                        <div class="col-lg-1"></div>
                        <div class="col-lg-3">
                            <label style="float: right">{{"DEACTIVATED_DRIVERS.UPLOAD_CSV" | translate}} </label>
                        </div>
                        <div class="col-lg-1">:</div>
                        <div class="col-lg-4" style="margin-left: -12%;">
                            <div name="upload" class="col-lg-3" id="uploadForm" enctype="multipart/form-data" style="width:100%;">
                                <input valid-file type="file" my-upload ng-model="fileName" file-model="fileName" file-change="handler($event,files)" class="form-control"
                                    name="fileName" accept=".csv" style="margin-left: 37%;width: 76%" required/>
                                <a href="app/csvSample/bulk_deactivate_driver.csv" download style="margin-right: -50%;">{{"DEACTIVATED_DRIVERS.DOWNLOAD_SAMPLE_CSV" | translate}}</a>
                            </div>
                        </div>
                        <div class="col-lg-2">
                            <md-button class="md-raised fancyButton" style="margin-top: 0" ng-click="UploadCsvDriver();">{{"DEACTIVATED_DRIVERS.UPLOAD_CSV" | translate}}</md-button>

                            <i class="fa fa-info-circle fa-2x" data-toggle="tooltip" data-placement="top" title="Sample CSV Format" style="color:black;margin-left: 2%;"
                                aria-hidden="true" ng-click="demoDialog=true"></i>

                        </div>
                    </div>
                    <br>
                    <div class="row">
                        <div class="col-lg-1">
                        </div>
                        <div class="col-lg-3" style="overflow:hidden;">

                            <label style="float: right">{{"DEACTIVATED_DRIVERS.SELECT_TIME_PERIODS" | translate}} </label>
                        </div>
                        <div class="col-lg-1">:</div>

                        <div class="col-lg-6" style="margin-top: -2%;margin-left: -7%;">
                            <select style="width:72%;margin: 12px auto 0px;" class="form-control" ng-model="driver_Block_reason_time">
                                <option value="-1">{{"DEACTIVATED_DRIVERS.SELECT_TIME_PERIOD" | translate}}</option>
                                <option value="1">{{"DEACTIVATED_DRIVERS.SELECT_TIME_NORMAL" | translate}}</option>
                                <option value="24">{{"DEACTIVATED_DRIVERS.SELECT_TIME_HOUR" | translate}} </option>

                            </select>

                        </div>

                    </div>
                    <br>
                    <div class="row">
                        <div class="col-lg-1">
                        </div>
                        <div class="col-lg-3" style="overflow:hidden;">

                            <label style="float: right">{{"DEACTIVATED_DRIVERS.SELECT_REASON" | translate}} </label>
                        </div>
                        <div class="col-lg-1">:</div>

                        <div class="col-lg-6" style="margin-top: -2%;margin-left: -7%;">
                            <select style="width:72%;margin: 12px auto 0px;" class="form-control" ng-model="deactivate_driver_Block_reason">
                                <option value="-1">{{"DEACTIVATED_DRIVERS.SELECT_REASON" | translate}}</option>
                                <option ng-repeat="items in ddnSuspendList" value="{{items.id}}">{{items.reason_text}}</option>
                            </select>

                        </div>

                    </div>
                    <div class="row">
                        <div class="col-lg-1">
                        </div>
                        <div class="col-lg-3" style="margin-top: 2%;">
                            <label style="float: right">{{"DEACTIVATED_DRIVERS.COMMENTS" | translate}}</label>
                        </div>
                        <div class="col-lg-1" style="margin-top: 2%;">:</div>

                        <div class=" col-lg-6" style="overflow:hidden">
                            <div style="margin-right: -32%;">{{"DEACTIVATED_DRIVERS.HEADING_COUNT" | translate}}:
                                <span class="textAr">{{newSuspendTextForBulk.length ? newSuspendTextForBulk.length : 0}}</span>
                            </div>
                            <div class="form-group" style="margin-top:-2%;margin-left: -29%;">
                                <textarea style="width:56%;margin: 12px auto 0px" rows="2" class="form-control textAr" ng-init="newSuspendText = ''" ng-model="newSuspendTextForBulk"
                                    placeholder='{{"DEACTIVATED_DRIVERS.PLACEHOLDER_COMMENTS" | translate}}'>

                                    </textarea>
                            </div>

                            <md-button class="md-raised fancyButton" ng-disabled="disabledButton" style="margin-left: -29%;" ng-click="suspendbulkDriver(jugnoo_suspend_bulk,dodo_suspend_bulk,deactivate_driver_Block_reason,driver_Block_reason_time,newSuspendTextForBulk)">
                                {{"DEACTIVATED_DRIVERS.BUTTON_DEACTIVATE" | translate}}
                            </md-button>
                            <md-button class="md-raised md-warn" data-dismiss="modal" aria-hidden="true">{{"DEACTIVATED_DRIVERS.BUTTON_CANCEL" | translate}}</md-button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <modal title="Sample CSV Format" class="dashboardDialogModal" visible="demoDialog">

        <div class="row">
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead class="thead-style">
                        <tr>
                            <th>{{"DEACTIVATED_DRIVERS.DRIVER_ID" | translate}}</th>
                        </tr>
                    </thead>
                    <tr>
                        <td>1111</td>
                    </tr>
                    <tr>
                        <td>2222</td>
                    </tr>
                    <tr>
                        <td>3333</td>
                    </tr>
                </table>
            </div>
        </div>

    </modal>

    <modal title="Warning" class="warningModal" visible="warning_flag">
        <h4 style="text-align: center">{{alert_message| translate}}</h4>
    </modal>

    <modal title="Success" class="successModal" visible="success_flag">
        <h4 style="text-align: center">{{alert_message| translate}}</h4>
        <div class="modal_buttons">
            <button class="btn btn-primary-custom" ng-click="confirm_box()">{{"DEACTIVATED_DRIVERS.BUTTON_OK" | translate}}</button>
        </div>

    </modal>

    <modal title="Success" class="successModal" visible="success_flag_upload">
        <h4 style="text-align: center">{{alert_message| translate}}</h4>
    </modal>

    <modal title="Error" class="errorModal" visible="error_flag">
        <div class=" text-center">
            <h4 style="text-align: center">{{alert_message| translate}}</h4>
        </div>
    </modal>
</div>