                    <td ng-if="operator == 1">{{data.dodo_enabled == 0?'No':'Yes'}}</td>
                    <td ng-if="operator == 1">{{data.last_seven_days_delivery_avg?(data.last_seven_days_delivery_avg| number:2):'--'}}</td>
                    <td ng-if="operator == 1">{{data.last_thirty_days_delivery_avg?(data.last_thirty_days_delivery_avg| number:2):'--'}}</td>
                    <td ng-if="operator == 1">{{data.dodo_enabled_on ? (data.dodo_enabled_on | date : 'yyyy-MM-dd hh:mm a') : "--"}}</td>
                    <td ng-if="operator == 1">{{data.last_delivery_on != "0000-00-00 00:00:00" ? (data.last_delivery_on | date : 'yyyy-MM-dd hh:mm
                        a') : "--"}}</td>
                        <td ng-show="finalpermission.viewOtp"><md-button class="fancyButton" ng-click="viewOTP(data.driver_id,$event)">{{"ACTIVE_DRIVERS.VIEW_OTP" | translate}}</md-button></td>
                </tr>
            </tbody>
        </table>
