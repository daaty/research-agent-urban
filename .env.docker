# ========================================
# CONFIGURAÇÕES DE AMBIENTE - RESEARCH AGENT URBAN VNC
# ========================================

# 🔐 CREDENCIAIS (OBRIGATÓRIO)
RIDES_USERNAME=herbert@urbandobrasil.com.br
RIDES_PASSWORD=herbert@urban25
N8N_WEBHOOK_URL=https://n8n.urbanmt.com.br/webhook-test/rideswebscrap

# 🗄️ CONFIGURAÇÕES DO BANCO POSTGRESQL (USANDO POSTGRES EXISTENTE)
DATABASE_URL=postgresql://rides_user:rides_password@n8n_postgres:5432/rides_db
DB_HOST=n8n_postgres
DB_PORT=5432
DB_NAME=rides_db
DB_USER=rides_user
DB_PASSWORD=rides_password
DB_SSL=false

# 🎛️ FUNCIONALIDADES
ENABLE_DATABASE=true
ENABLE_WEBHOOK=true

# 🌐 URLs DO SISTEMA
RIDES_LOGIN_URL=https://rides.ec2dashboard.com/#/page/login

# 🖥️ CONFIGURAÇÕES VNC
VNC_PASSWORD=suasenhaVNC123
DISPLAY=:99

# 🌐 NAVEGADOR
BROWSER_HEADLESS=false
BROWSER_TIMEOUT=30000

# ⏰ SCRAPING
SCRAPE_INTERVAL=2.5
MAX_RETRIES=3
CACHE_ENABLED=true

# 🚀 SERVIDOR (NOVA VERSÃO COM POSTGRESQL - PORTAS DIFERENTES)
PORT=3040
VNC_PORT=6090
NOVNC_PORT=6091
NODE_ENV=production

# 🌍 TIMEZONE
TZ=America/Sao_Paulo
