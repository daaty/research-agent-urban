# 🔐 CREDENCIAIS (OBRIGATÓRIO)
RIDES_USERNAME=seu_email@exemplo.com
RIDES_PASSWORD=sua_senha_aqui
N8N_WEBHOOK_URL=https://seu-n8n.com/webhook/rideswebscrap

# 🗄️ CONFIGURAÇÕES DO BANCO POSTGRESQL
DATABASE_URL=postgresql://postgres:senha123@localhost:5432/rides_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rides_db
DB_USER=postgres
DB_PASSWORD=senha123
DB_SSL=false

# 🎛️ FUNCIONALIDADES
ENABLE_DATABASE=true
ENABLE_WEBHOOK=true

# 🌐 URLs DO SISTEMA
RIDES_LOGIN_URL=https://carreira.ridesapp.com.br/driver/login

# 🖥️ CONFIGURAÇÕES VNC
VNC_PASSWORD=suasenhaVNC123
DISPLAY=:99

# 🌐 NAVEGADOR
BROWSER_HEADLESS=false
BROWSER_TIMEOUT=30000

# ⏰ SCRAPING
SCRAPE_INTERVAL=2.5
MAX_RETRIES=3
CACHE_ENABLED=true

# 🚀 SERVIDOR (PORTA DIFERENTE DO CHATWOOT)
PORT=3030
NODE_ENV=production

# 🌍 TIMEZONE
TZ=America/Sao_Paulo
