{
  "name": "research-agent-urban-ai",
  "version": "3.0.0",
  "description": "Research Agent Urban - AI-Powered Web Automation with PostgreSQL Integration",
  "main": "dist/app-persistent.js",
  "scripts": {
    "build": "tsc -p tsconfig.prod.json",
    "start": "node dist/app-persistent.js",
    "start:legacy": "node dist/auto-scraper.js",
    "start:monitoring": "node dist/start-monitoring.js",
    "dev": "ts-node-dev --respawn --transpile-only src/app-persistent.ts",
    "dev:legacy": "ts-node-dev --respawn --transpile-only src/auto-scraper.ts",
    "dev:monitoring": "ts-node-dev --respawn --transpile-only start-monitoring.ts",
    "start:local": "ts-node start-local.ts",
    "start:local:continuous": "ts-node start-local.ts --continuous",
    "test:local": "ts-node start-local.ts",
    "clean": "rimraf dist browser-data session-data.json cache-data.json",
    "clean:all": "rimraf dist browser-data session-data.json cache-data.json node_modules",
    "prebuild": "npm run clean",
    "prod": "npm run build && npm start",
    "prod:monitoring": "npm run build && npm run start:monitoring",
    "setup": "npm install && npm run install-browsers && npm run build",
    "setup:docker": "npm install --production && npm run install-browsers && npm run build",
    "setup:local": "npm install && npm run install-browsers && node -e \"require('fs').copyFileSync('.env.local', '.env')\"",
    "playwright-install": "npx playwright install chromium --with-deps",
    "playwright-install-docker": "npx playwright install chromium",
    "install-browsers": "npm run playwright-install",
    "install-browsers:docker": "npm run playwright-install-docker",
    "test:database": "ts-node-dev --respawn --transpile-only test-database-integration.ts",
    "test:ai": "ts-node-dev --respawn --transpile-only test-ai-agent.ts",
    "test:anti-duplication": "ts-node-dev --respawn --transpile-only test-anti-duplication.ts",
    "test:drivers": "ts-node test-drivers-performance.ts",
    "test:drivers-performance": "ts-node test-drivers-performance.ts",
    "test:browser": "ts-node -e \"import { BrowserSessionManager } from './src/services/browserSessionManager'; const browser = new BrowserSessionManager(); browser.ensureBrowserIsActive().then(() => console.log('✅ Browser OK')).catch(console.error);\"",
    "test:environment": "ts-node -e \"import { EnvironmentDetector } from './src/config/environmentDetector'; EnvironmentDetector.getInstance().logEnvironmentInfo();\"",
    "health-check": "curl -f http://localhost:3000/api/status || exit 1"
  },
  "dependencies": {
    "@google/generative-ai": "^0.19.0",
    "axios": "^1.10.0",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "node-cron": "^4.2.1",
    "node-fetch": "^2.7.0",
    "pg": "^8.11.0",
    "pg-connection-string": "^2.9.1",
    "playwright": "^1.55.0",
    "puppeteer": "^19.11.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.2",
    "@types/node-cron": "^3.0.11",
    "@types/node-fetch": "^2.6.12",
    "@types/pg": "^8.10.0",
    "rimraf": "^6.0.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "ai-agent",
    "web-automation",
    "scraping",
    "postgresql",
    "gemini-ai",
    "docker"
  ],
  "author": "Research Agent Urban Team",
  "license": "MIT"
}
