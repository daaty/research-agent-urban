# ========================================
# CONFIGURAÇÃO PARA EXECUÇÃO LOCAL
# ========================================

# 🔐 CREDENCIAIS DO SISTEMA
RIDES_USERNAME=herbert@urbandobrasil.com.br
RIDES_PASSWORD=herbert@urban25

# 🌐 WEBHOOK (opcional para teste local)
N8N_WEBHOOK_URL=https://n8n.urbanmt.com.br/webhook/rideswebscrap

# 🗄️ BANCO DE DADOS
# Usar banco VPS (recomendado)
DATABASE_URL=postgres://n8n_user:n8n_pw@148.230.73.27:5432/n8n_db?sslmode=disable

# 🎛️ FUNCIONALIDADES
ENABLE_DATABASE=true
ENABLE_WEBHOOK=true
ALLOW_NO_DATABASE=false

# 🌐 URLs DO SISTEMA
RIDES_LOGIN_URL="https://rides.ec2dashboard.com/#/page/login"

# 🖥️ CONFIGURAÇÕES VNC OTIMIZADAS (RESOLUÇÃO 1600x1200)
VNC_PASSWORD=suasenhaVNC123
DISPLAY=:99
VNC_RESOLUTION=1600x1200
VNC_DEPTH=24
VNC_DPI=96
VNC_SHARED=true
VNC_GEOMETRY=1600x1200
VNC_SCALE=1600x1200

# 🪟 WINDOW MANAGER PARA MÚLTIPLOS NAVEGADORES
WINDOW_MANAGER=openbox
TASKBAR_ENABLED=true
MULTI_BROWSER_MODE=true
BROWSER_TILING=true

# 🌐 NAVEGADOR OTIMIZADO PARA VNC
BROWSER_HEADLESS=false
BROWSER_TIMEOUT=30000
BROWSER_WIDTH=1600
BROWSER_HEIGHT=1200
HEADLESS_MODE=false

# ⏰ CONFIGURAÇÕES DE SCRAPING OTIMIZADAS
ENABLE_AUTO_SCRAPING=true
SCRAPE_INTERVAL=5
MAX_RETRIES=3
CACHE_ENABLED=true

# 🚀 SERVIDOR (PORTAS EASYPANEL)
PORT=3040
VNC_PORT=6090
NOVNC_PORT=6091
NODE_ENV=production

# 🌍 TIMEZONE E LOCALIZAÇÃO
TZ=America/Sao_Paulo

# 🔄 SISTEMA HÍBRIDO - CONFIGURAÇÕES DE PERFORMANCE
AUTO_START_HYBRID=true
AUTO_START=true
HYBRID_EXTRACTION_BATCH_SIZE=1
HYBRID_STATE_CHECK_INTERVAL=8000
HYBRID_MAX_RETRIES=3
HYBRID_TIMEOUT=30000

# 🏙️ CONFIGURAÇÃO DA CIDADE (SISTEMA HÍBRIDO)
CITY_NAME=Matupá
CITY_ENABLED=true

# 📊 SISTEMA DE LOGGING AVANÇADO
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_CONSOLE_LEVEL=INFO

# 🔧 CONFIGURAÇÕES AVANÇADAS DE PERFORMANCE
ENABLE_MONITORING=true
ENABLE_METRICS=true
HEALTH_CHECK_INTERVAL=30000

# 🚨 CONFIGURAÇÕES DE SEGURANÇA VPS
SECURITY_HEADERS=true
CORS_ENABLED=true
RATE_LIMITING=true

# 🔄 CONFIGURAÇÕES DE RECARGA (API)
RECHARGE_API_ENABLED=true
RECHARGE_TRACKING_ENABLED=true
RECHARGE_MAX_QUEUE_SIZE=100

# 🎯 CONFIGURAÇÕES DE EXTRAÇÃO DE DADOS
DATA_EXTRACTION_TIMEOUT=60000
DATA_EXTRACTION_RETRIES=3
DATA_VALIDATION_ENABLED=true

# 📡 CONFIGURAÇÕES DE REDE E CONECTIVIDADE
CONNECTION_TIMEOUT=30000
REQUEST_TIMEOUT=60000
RETRY_DELAY=5000

# 🔍 CONFIGURAÇÕES DE DEBUG E DESENVOLVIMENTO
DEBUG_MODE=false
VERBOSE_LOGGING=false
SCREENSHOT_ON_ERROR=true

# 🎪 CONFIGURAÇÕES ESPECÍFICAS DO PLAYWRIGHT
#PLAYWRIGHT_BROWSERS_PATH=/app/browsers
#PLAYWRIGHT_SLOW_MO=100

# 📦 CONFIGURAÇÕES DE CACHE E STORAGE
CACHE_TTL=3600000
CACHE_MAX_SIZE=100
SESSION_TIMEOUT=7200000

# 🔄 CONFIGURAÇÕES DE RETRY E RESILÊNCIA
MAX_BROWSER_RESTARTS=3
BROWSER_RESTART_DELAY=10000
SESSION_RECOVERY_ENABLED=true

# 🌐 CONFIGURAÇÕES DE PROXY E REDE (SE NECESSÁRIO)
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1

# 📈 CONFIGURAÇÕES DE MÉTRICAS E MONITORAMENTO
METRICS_ENABLED=true
METRICS_INTERVAL=60000
HEALTH_CHECK_ENABLED=true

# 🎨 CONFIGURAÇÕES DE UI/UX VNC
VNC_CURSOR_VISIBLE=true
VNC_SCROLL_ENABLED=true
VNC_KEYBOARD_LAYOUT=pt-br

# 🔧 CONFIGURAÇÕES EXPERIMENTAIS
EXPERIMENTAL_FEATURES=false
BETA_FEATURES=false

# ==========================================
# VARIÁVEIS ESPECÍFICAS PARA EASYPANEL/DOCKER
# ==========================================

# Container Health Check
HEALTHCHECK_ENABLED=true
HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=10s
HEALTHCHECK_RETRIES=3

# Resource Limits
MEMORY_LIMIT=2048m
CPU_LIMIT=1000m

# Restart Policy
RESTART_POLICY=always


# 🐌 CONTROLE DE VELOCIDADE DO HYBRID SCRAPER
# Multiplica os delays base para controlar velocidade de extração
# 1.0 = Velocidade normal
# 1.5 = 50% mais lento (RECOMENDADO para maior estabilidade)
# 2.0 = 100% mais lento (para conexões muito instáveis)
# 0.8 = 20% mais rápido (apenas para testes em ambiente estável)
HYBRID_SPEED_MULTIPLIER=3.5


# ==========================================
# NOTAS DE CONFIGURAÇÃO:
# ==========================================
# 
# 1. VNC: Resolução otimizada 1600x1200 para visualização completa
# 2. Sistema Híbrido: Processamento sequencial com intervalos de 8s
# 3. Logging: Arquivos categorizados com rotação automática
# 4. API: Sistema completo de recarga com tracking
# 5. Performance: Cache habilitado e timeouts otimizados
# 6. Segurança: Headers de segurança e CORS configurados
# 7. Monitoramento: Health checks e métricas habilitadas
#
# Para usar no EasyPanel:
# - Copie estas variáveis para a seção Environment Variables
# - Ajuste DATABASE_URL se necessário
# - Verifique as portas (3040, 6090, 6091)
# - Configure volumes para /app/logs e /app/browser-data
#
# ==========================================
